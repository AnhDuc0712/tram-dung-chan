; Engine configuration file.
; Mở bằng Godot 4.7: tools\edit.ps1  (hoặc tools\godot\Godot_v4.7.2-stable_win64.exe --path game -e)

config_version=5

[application]

config/name="Trạm Dừng Chân"
config/description="Tập 1: Cú va chạm · Tập 2: Cơn bão nhỏ."
config/version="1.2.1"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.11, 0.08, 0.09, 1)
boot_splash/image="res://assets/art/ui/splash.png"
boot_splash/stretch_mode=1

[autoload]

GameState="*res://autoload/game_state.gd"
Ui="*res://autoload/ui.gd"
Audio="*res://autoload/audio.gd"
Story="*res://autoload/story.gd"
Dialogue="*res://autoload/dialogue_manager.gd"
Hud="*res://autoload/hud.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[rendering]

textures/canvas_textures/default_texture_filter=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12, 0.09, 0.08, 1)

[importer_defaults]

texture={
"compress/lossy_quality": 0.85,
"compress/mode": 1
}
